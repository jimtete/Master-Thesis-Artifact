@page "/counter"
@using OlympusVMS.Integration.Microsoft
@using OlympusVMS.Integration.Microsoft.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Identity.Web
@inject IMicrosoftCalendarService CalendarService
@inject ILogger<Counter> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler

<PageTitle>Meeting Rooms Overview</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (isLoading)
        {
            <p>Loading...</p>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else
        {
            <h1>External Attendees Summary (Next 7 Days)</h1>
            @if (meetings.Count == 0)
            {
                <div class="alert alert-info">No meetings found in configured rooms for the next 7 days.</div>
            }
            else
            {
                var hasExternalEntries = false;

                <table class="table table-striped mb-5">
                    <thead>
                        <tr>
                            <th>Meeting Name</th>
                            <th>Meeting Time</th>
                            <th>External Attendees (non @@capital-four.com)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var meeting in meetings)
                        {
                            var externalCount = GetExternalAttendeeCount(meeting);
                            if (externalCount > 0)
                            {
                                hasExternalEntries = true;
                                <tr>
                                    <td>@meeting.Subject</td>
                                    <td>@meeting.Start?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@externalCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                @if (!hasExternalEntries)
                {
                    <div class="alert alert-info">No meetings with external attendees were found.</div>
                }
            }

            <h1>Fetched Meetings from Meeting Rooms (Next 7 Days)</h1>
            @if (meetings.Count == 0)
            {
                <div class="alert alert-info">No meetings found in configured rooms for the next 7 days.</div>
            }
            else
            {
                <table class="table table-striped mb-5">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Location</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Organizer</th>
                            <th>Total Attendees</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var meeting in meetings)
                        {
                            <tr>
                                <td>@meeting.Subject</td>
                                <td>@meeting.Location</td>
                                <td>@meeting.Start?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@meeting.End?.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@meeting.Organizer</td>
                                <td>@meeting.Attendees.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h1>Configured Meeting Rooms</h1>
            @if (rooms.Count == 0)
            {
                <div class="alert alert-info">No meeting rooms configured.</div>
            }
            else
            {
                <table class="table table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Room Name</th>
                            <th>Email Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in rooms)
                        {
                            <tr>
                                <td><strong>@room.DisplayName</strong></td>
                                <td>@room.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Please Sign In</h1>
        <p>
            <a href="MicrosoftIdentity/Account/SignIn" class="btn btn-primary">Sign In with Microsoft</a>
        </p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string CompanyDomain = "@capital-four.com";

    private List<MeetingDto> meetings = new();
    private List<RoomDto> rooms = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var start = DateTime.Now;
            var end = DateTime.Now.AddDays(7);

            var meetingsTask = CalendarService.GetConfiguredRoomMeetingsAsync(start, end);
            var roomsTask = CalendarService.GetAllMeetingRoomsAsync();

            await Task.WhenAll(meetingsTask, roomsTask);

            meetings = await meetingsTask;
            rooms = await roomsTask;
        }
        catch (MicrosoftIdentityWebChallengeUserException ex)
        {
            ConsentHandler.HandleException(ex); // triggers auth challenge
            return;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading calendar data: {ex.Message}";
            Logger.LogError(ex, "Failed to load calendar data");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static int GetExternalAttendeeCount(MeetingDto meeting)
    {
        return meeting.Attendees.Count(attendee =>
            !string.IsNullOrWhiteSpace(attendee.Email) &&
            !attendee.Email.EndsWith(CompanyDomain, StringComparison.OrdinalIgnoreCase));
    }
}