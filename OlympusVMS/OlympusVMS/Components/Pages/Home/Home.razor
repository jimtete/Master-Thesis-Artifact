@page "/"

<PageTitle>Home</PageTitle>

<h1>Meetings for @DateTime.Today.ToShortDateString()</h1>
<h3>Upcoming Meetings</h3>

<table class="table">
    <thead>
    <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Meeting Time</th>
    </tr>
    </thead>
    <tbody>
        @foreach (var guest in Meetings)
        {
            <tr>
                <td>@guest.FirstName</td>
                <td>@guest.LastName</td>
                <td>@guest.MeetingTime.ToString("yyyy-MM-dd HH:mm")</td>

            </tr>
        }
    </tbody>
</table>

@code {
    private List<MeetingRow> Meetings = new()
    {
        new("Anna", "Jensen", DateTime.Now.AddHours(1)),
        new("Nikos", "Papadopoulos", DateTime.Now.AddHours(2)),
        new("Maria", "Khan", DateTime.Now.AddDays(1).AddHours(3)),
    };

    private sealed record MeetingRow(string FirstName, string LastName, DateTime MeetingTime);
}

