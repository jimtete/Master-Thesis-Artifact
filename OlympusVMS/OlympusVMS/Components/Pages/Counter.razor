@page "/counter"
@using OlympusVMS.Integration.Microsoft
@using OlympusVMS.Integration.Microsoft.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IMicrosoftCalendarService CalendarService
@inject ILogger<Counter> Logger

<PageTitle>My Meetings</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>My Meetings (Next 7 Days)</h1>

        @if (isLoading)
        {
            <p>Loading...</p>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (meetings.Count == 0)
        {
            <div class="alert alert-info">No meetings found in the next 7 days.</div>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Location</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Organizer</th>
                        <th>Attendees</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var meeting in meetings)
                    {
                        <tr>
                            <td>@meeting.Subject</td>
                            <td>@meeting.Location</td>
                            <td>@meeting.Start?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@meeting.End?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@meeting.Organizer</td>
                            <td>@meeting.Attendees.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Authorized>
    <NotAuthorized>
        <h1>Please Sign In</h1>
        <p>
            <a href="MicrosoftIdentity/Account/SignIn" class="btn btn-primary">Sign In with Microsoft</a>
        </p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<MeetingDto> meetings = new();
    private bool isLoading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var start = DateTime.Now;
            var end = DateTime.Now.AddDays(7);
            
            meetings = await CalendarService.GetMyMeetingsAsync(start, end);
            Logger.LogInformation($"Loaded {meetings.Count} meetings");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading meetings: {ex.Message}";
            Logger.LogError(ex, "Failed to load meetings");
        }
        finally
        {
            isLoading = false;
        }
    }
}